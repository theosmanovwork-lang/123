{
  "$comment": "Prufbase design tokens. Source of truth: src/app/globals.css. Units are px on web = dp (Android) = pt (iOS). Alpha colours are written as #RRGGBBAA.",
  "colors": {
    "dark": {
      "background": "#08090A",
      "surface": "#0F1011",
      "surfaceMuted": "#141516",
      "hover": "#FFFFFF0D",
      "border": "#FFFFFF14",
      "fieldBorder": "#62666D",
      "fieldFill": "#141516",
      "textPrimary": "#F7F8F8",
      "textSecondary": "#D0D6E0",
      "textMuted": "#9CA1AB",
      "accent": "#E5E5E6",
      "onAccent": "#08090A",
      "accentText": "#D0D6E0",
      "ctaFill": "#E5E5E6",
      "ctaFillPressed": "#FFFFFF",
      "ctaText": "#08090A",
      "focusRing": "#8A8F98",
      "destructive": "#FF6B6B"
    },
    "light": {
      "background": "#FFFFFF",
      "surface": "#F9F8F9",
      "surfaceMuted": "#F4F2F4",
      "hover": "#EEEDEF",
      "border": "#E4E2E4",
      "fieldBorder": "#7B808A",
      "fieldFill": "#F4F2F4",
      "textPrimary": "#1C1D1F",
      "textSecondary": "#3A3C41",
      "textMuted": "#4A4E56",
      "accent": "#1C1D1F",
      "onAccent": "#FFFFFF",
      "accentText": "#1C1D1F",
      "ctaFill": "#1C1D1F",
      "ctaFillPressed": "#3A3C41",
      "ctaText": "#FFFFFF",
      "focusRing": "#62666D",
      "destructive": "#C23B3B"
    }
  },
  "typography": {
    "families": {
      "sans": "Inter Variable (OpenType features: cv01, ss03)",
      "mono": "JetBrains Mono (numbers, labels, code)"
    },
    "weights": { "regular": 400, "medium": 510, "semibold": 510, "bold": 590 },
    "styles": {
      "display":   { "size": 64, "line": 67, "weight": 510, "tracking": -0.022, "mobileSize": 36, "mobileLine": 39 },
      "h2":        { "size": 48, "line": 53, "weight": 510, "tracking": -0.022, "mobileSize": 30, "mobileLine": 36 },
      "h3":        { "size": 18, "line": 28, "weight": 590, "tracking": 0 },
      "lead":      { "size": 18, "line": 29, "weight": 400, "mobileSize": 16, "mobileLine": 26, "color": "textSecondary" },
      "body":      { "size": 15, "line": 24, "weight": 400, "color": "textSecondary" },
      "bodySmall": { "size": 14, "line": 20, "weight": 400, "color": "textMuted" },
      "title":     { "size": 14, "line": 18, "weight": 590 },
      "caption":   { "size": 12, "line": 16, "weight": 400, "color": "textMuted" },
      "label":     { "size": 11, "line": 15, "weight": 590, "tracking": 0.02, "uppercase": false },
      "labelCaps": { "size": 11, "line": 15, "weight": 590, "tracking": 0.05, "uppercase": true },
      "eyebrow":   { "size": 12, "line": 16, "family": "mono", "tracking": 0.05, "uppercase": true },
      "figureXL":  { "size": 24, "line": 32, "family": "mono", "weight": 590, "tabularNums": true },
      "figure":    { "size": 14, "line": 20, "family": "mono", "weight": 590, "tabularNums": true },
      "figureSm":  { "size": 11, "line": 15, "family": "mono", "weight": 590, "tabularNums": true }
    }
  },
  "spacing": { "unit": 4, "scale": [4, 8, 12, 16, 20, 24, 32, 48, 64, 96], "screenMargin": 16, "sectionGap": { "mobile": 64, "desktop": 96 } },
  "radius": { "chip": 8, "control": 8, "card": 10, "panel": 14, "pill": 9999 },
  "border": { "hairline": 1 },
  "elevation": "none (flat). Only the CTA pill has a 5-layer 1px-scale shadow.",
  "touch": { "minTarget": 44, "primaryButtonHeight": 48, "inputHeight": 44 },
  "motion": {
    "ui":          { "duration": 160, "easing": [0.25, 0.46, 0.45, 0.94] },
    "heroWord":    { "duration": 700, "delay": 80, "stagger": 25, "easing": [0.25, 0.1, 0.25, 1], "from": { "opacity": 0, "blur": 10, "translateYPercent": 20 } },
    "sectionIn":   { "from": { "opacity": 0, "blur": 6, "translateY": 16 }, "tiedToScroll": true },
    "barSlide":    { "duration": 300, "easing": "ease-out" },
    "pressScale":  0.98,
    "reducedMotion": "disable blur/translate, keep opacity only"
  }
}
